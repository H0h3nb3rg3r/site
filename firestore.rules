rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Visitantes só podem CRIAR contatos válidos. Ninguém lê, edita ou apaga pelo site.
    match /contatos/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['nome', 'email', 'telefone', 'assunto', 'mensagem', 'aceite', 'criadoEm'])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() >= 3
                    && request.resource.data.nome.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.telefone is string
                    && request.resource.data.telefone.size() <= 20
                    && request.resource.data.assunto is string
                    && request.resource.data.assunto.size() <= 60
                    && request.resource.data.mensagem is string
                    && request.resource.data.mensagem.size() >= 10
                    && request.resource.data.mensagem.size() <= 2000
                    && request.resource.data.aceite == true
                    && request.resource.data.criadoEm == request.time;
      allow read, update, delete: if false;
    }
  }
}